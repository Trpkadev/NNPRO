{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "DatabaseLimitsOptions": {
    "MaxItemsLoadedWithoutPagination": 250,
    "DefaultPageSize": 20
  },
  "JwtOptions": {
    "AccessTokenExpirationMinutes": 10,
    "RefreshTokenExpirationDays": 1
  },
  "Config": {
    "NetworkDelayToleranceSeconds": 5
  },
  "AllowedHosts": "*"
}