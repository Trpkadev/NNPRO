{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:8080"
      },
      "Https": {
        "Url": "https://0.0.0.0:8081"
      }
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "https://localhost:5173"
    ]
  },
  "DatabaseLimits": {
    "MaxItemsLoadedWithoutPagination": 250,
    "DefaultPageSize": 20
  },
  "Jwt": {
    "AccessTokenExpirationMinutes": 10,
    "RefreshTokenExpirationDays": 1
  },
  "AllowedHosts": "*"
}